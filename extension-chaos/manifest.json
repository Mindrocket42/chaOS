{
  "manifest_version": 3,
  "name": "chaOS Local Bridge",
  "version": "0.1.0",
  "description": "Explicit browser-to-local bridge for ChatGPT. No MCP tunnel required.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "chaOS Local Bridge"
  }
}
